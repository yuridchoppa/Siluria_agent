# Anakin.io API Key & Base URL (Get from https://anakin.io/dashboard)
ANAKIN_API_KEY=your_anakin_api_key_here
ANAKIN_BASE_URL=https://api.anakin.ai/v1

# Google Gemini API Key (Get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional, for DALL-E image generation)
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration (Gemini or Anakin/OpenAI)
# For Gemini: DEFAULT_MODEL=gemini-flash-latest
# For Anakin: DEFAULT_MODEL=gpt-4o, MODEL_FALLBACKS=gpt-4o,claude-3-5-sonnet-20241022,gemini-1.5-pro
DEFAULT_MODEL=gemini-flash-latest
MODEL_FALLBACKS=gemini-flash-latest,gemini-3-flash-preview,gemini-3.1-flash-lite-preview

CODE_EXEC_TIMEOUT=30
WORKSPACE_DIR=workspace
